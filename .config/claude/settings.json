{
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1",
    "CLAUDE_CODE_MONITOR_GHOSTTY_ASKED": "1",
    "DISABLE_ERROR_REPORTING": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Read",
      "Skill(pr)",
      "Bash(npm run lint)",
      "Bash(npm run test)",
      "Bash(pnpm run lint)",
      "Bash(pnpm run test)",
      "WebSearch",
      "mcp__sequential-thinking",
      "mcp__context7",
      "mcp__deepwiki",
      "mcp__plugin_claude-mem_mcp-search",
      "mcp__plugin_slack_slack__slack_read_channel",
      "mcp__plugin_slack_slack__slack_read_thread",
      "mcp__plugin_slack_slack__slack_read_canvas",
      "mcp__plugin_slack_slack__slack_read_user_profile",
      "mcp__plugin_slack_slack__slack_search_public",
      "mcp__plugin_slack_slack__slack_search_public_and_private",
      "mcp__plugin_slack_slack__slack_search_channels",
      "mcp__plugin_slack_slack__slack_search_users",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr status *)",
      "Bash(gh pr checks *)"
    ],
    "ask": [
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(git commit *)",
      "Bash(git -C * commit *)"
    ],
    "deny": [
      "Read(*.env*)",
      "Read(*.env)",
      "Read(*.env.local)",
      "Read(*.env.development)",
      "Read(*.env.production)",
      "Read(*.env.staging)",
      "Read(*.env.test)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "skillOverrides": {
    "find-skills": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/hook_validate_bash/check.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/hino/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/hook_stop_words/check.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh $HOME/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "claude-mem@thedotmack": true,
    "document-skills@anthropic-agent-skills": false,
    "example-skills@anthropic-agent-skills": false,
    "figma@claude-plugins-official": false,
    "slack@claude-plugins-official": true
  },
  "outputStyle": "Explanatory",
  "language": "Japanese",
  "effortLevel": "high",
  "plansDirectory": "./.claude/plans",
  "tui": "default",
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "terminalProgressBarEnabled": true,
  "teammateMode": "in-process",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true,
  "notificationChannel": "auto"
}
