.DS_Store

# `gh skill` writes this on every install, regardless of --dir/--scope, because
# it keeps a single user-scope lock (~/.agents -> here). It records install
# history only -- `gh skill update` reads the metadata in each SKILL.md
# frontmatter instead, so this file is machine-local and safe to drop.
.config/.agents/.skill-lock.json

# `terminal-browser setup` writes this symlink here (~/.agents -> .config/.agents).
# It points at a versioned Caskroom path, so it is machine- and version-local.
.config/.agents/skills/terminal-browser

# `ya pkg` deploys plugins here from the revisions pinned in
# .config/yazi/package.toml; restore them with `ya pkg install`.
.config/yazi/plugins/

# Personal, machine-local task list.
/TODO.md
